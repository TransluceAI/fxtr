# Runtime config written by the MCP plugin (from .fxtr_workstation.toml.example);
# not part of the committed flake, so keep it out of the tree current_commit()
# and retrieve_nix_entity build from.
.fxtr_workstation.toml

# The workflows' durable state (a two-sqlite-file pair per runner).
# Shares the workdir's lifetime, not part of the committed flake tree.
data/
data_behavior/

# nix build stderr dumps + any stray `nix build` result symlinks.
.tmp_outputs/
result
result-*

# Local venvs / Python caches.
.venv/
__pycache__/

# The repo entity store (local backing storage, minted on demand by the
# fxtr_nix_runner manager).
.fxtr/
