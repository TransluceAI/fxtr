# Copy to ``.fxtr_workstation.toml`` — the file the MCP plugin
# reads (only relevant when the demo backend runs with
# ``--enable-sandbox``, which mounts the agent MCP store). The URL +
# persistence-cap external name below match what
# ``run_experiment_demo.py`` prints / mounts (fixed port 8643 +
# external name ``agent_mcp_store``); only edit them if you've also
# edited the backend script.
#
# The MCP server populates ``active_session`` automatically the
# first time the agent calls the ``open_session`` tool, and clears
# it on ``close_session``.

workstation_url = "ws://127.0.0.1:8643"
agent_mcp_store = "agent_mcp_store"
# active_session = "<uuid>"
