# Persistence cap database (the agent_mcp_store SQLite file).
# Created on first run of run_demo_workstation.py; survives
# across runs so the agent's event log persists. `rm -rf .data/`
# wipes if you want a fresh start.
.data/

# Per-run sandbox wheel cache (forked from basic_test_demo).
.cache/

# The operator's edited toml — checked in only as
# .fxtr_workstation.toml.example.
agent_workdir/.fxtr_workstation.toml
