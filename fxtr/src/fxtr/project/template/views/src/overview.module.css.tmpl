/* The overview's own looks (overview.tsx), over the viewer's design tokens. */

/* A section's heading with its control at the right. */
.sectionHead { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-top: 14px; }
.sectionHead > h3 { margin: 0; }

.chart { display: block; overflow: visible; }
.guest { font-size: var(--text-sm); fill: var(--fg); }
