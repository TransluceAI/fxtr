# Copy to ``.fxtr_workstation.toml`` and edit ``workstation_url``
# to point at the URL printed by ``../run_demo_workstation.py``
# at startup (e.g. ``ws://127.0.0.1:<port>``).
#
# The MCP server will populate ``active_session`` automatically
# the first time the agent calls the ``open_session`` tool, and
# clear it on ``close_session``.

workstation_url = "ws://127.0.0.1:8765"
# active_session = "<uuid>"
