{
  "name": "fxtr-workstation-debug-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Standalone debug viewer for the fxtr workstation. Build artifacts are served by the workstation's /debug route. Not intended to be published or imported as a library.",
  "packageManager": "pnpm@10.12.2",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -b --noEmit",
    "build": "tsc -b && vite build",
    "preview": "vite preview"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
