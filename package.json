{
  "name": "fxtr-workspace",
  "private": true,
  "description": "The pnpm workspace root: the reusable TypeScript libraries in ts/ and the experiment viewer in frontend/.",
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm test:skills && pnpm -r test",
    "test:skills": "node --test scripts/skills/*.test.mjs",
    "sync:plugin": "node scripts/skills/sync.mjs",
    "build:dist": "pnpm --filter fxtr-ide build && uv build --package fxtr"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.12.2",
  "devDependencies": {
    "github-slugger": "^2.0.0",
    "mdast-util-to-string": "^4.0.0",
    "remark": "^15.0.1",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-mdx": "^3.1.1",
    "smol-toml": "^1.9.0",
    "unist-util-visit": "^5.1.0",
    "yaml": "^2.9.1"
  }
}
